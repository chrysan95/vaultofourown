# Copy to .env  (cp .env.example .env) — .env is git-ignored, never commit it.
POSTGRES_USER=vault
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vault

APP_PORT=5000
ADMINER_PORT=8080
LORE_CACHE_TTL=60

# Docker Hub bonus (optional)
DOCKERHUB_USER=local
APP_VERSION=1.0.0

# Shows the seeded accounts as buttons in the login dialog
DEMO_MODE=true
REDISINSIGHT_PORT=5540
# only used with compose.debug.yml
DB_DEBUG_PORT=5432
REDIS_DEBUG_PORT=6379
